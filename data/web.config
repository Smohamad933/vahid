<?xml version="1.0" encoding="utf-8"?>
<!-- مسدودسازی کامل دسترسی مستقیم وب به فایل‌های JSON پوشه data در IIS -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <clear />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
