<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- تنظیم صفحه پیش‌فرض برای ریشه یا زیرپوشه (مانند negahm.ir/vahidtaj یا negahm.ir/vahid-taj) -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- غیرفعال‌سازی نمایش محتویات پوشه‌ها -->
    <directoryBrowse enabled="false" />

    <!-- تعریف MIME Type استاندارد برای فونت‌های اختصاصی و فایل‌های صوتی در IIS -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".m4a" />
      <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
      <remove fileExtension=".ogg" />
      <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
      <remove fileExtension=".flac" />
      <mimeMap fileExtension=".flac" mimeType="audio/flac" />
      <remove fileExtension=".aac" />
      <mimeMap fileExtension=".aac" mimeType="audio/aac" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
    </staticContent>

    <!-- حذف هدرهای اضافی و افزایش سقف آپلود فایل صوتی/فونت تا ۲۰۰ مگابایت -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" maxQueryString="8190" maxUrl="8192" />
        <hiddenSegments>
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
</configuration>
